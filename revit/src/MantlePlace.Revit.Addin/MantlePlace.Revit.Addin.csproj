<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RevitApiRuntimeConfig>$(RevitApiDir)\RevitAPI.runtimeconfig.json</RevitApiRuntimeConfig>
    <RevitApiTargetFramework>net8.0-windows</RevitApiTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(RevitApiRuntimeConfig)')">
    <RevitApiTargetFramework Condition="$([System.IO.File]::ReadAllText('$(RevitApiRuntimeConfig)').Contains('&quot;net10.0&quot;'))">net10.0-windows</RevitApiTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>$(RevitApiTargetFramework)</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>MantlePlace.Revit.Addin</RootNamespace>
    <AssemblyName>MantlePlace.Revit.Addin</AssemblyName>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\MantlePlace.Core\MantlePlace.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\src\MantlePlace.Client\MantlePlace.Client.csproj" />
    <ProjectReference Include="..\..\..\shared\src\MantlePlace.Wpf\MantlePlace.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="MantlePlace.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Families\MantlePlaceTree.rfa" LogicalName="MantlePlace.Revit.Addin.Families.MantlePlaceTree.rfa" />
    <EmbeddedResource Include="Families\MantlePlaceShrub.rfa" LogicalName="MantlePlace.Revit.Addin.Families.MantlePlaceShrub.rfa" />
  </ItemGroup>

  <Target Name="CheckRevitApiDir" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(RevitApiDir)\RevitAPI.dll')"
      Text="Revit API assemblies not found at '$(RevitApiDir)'. The shim compiles against the OLDEST supported Revit (2025) so one build loads in 2025, 2026 and 2027. Install Revit 2025, or override: dotnet build -p:RevitApiDir=&quot;C:\Program Files\Autodesk\Revit 2026&quot;. The pure core and the client build and test without any Revit install." />
  </Target>

</Project>
