<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>$(HarnessAssemblyName)</AssemblyName>
    <RootNamespace>MantlePlace.Scratch.Timing</RootNamespace>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416;MSB3277;CS1591;CS8632</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.1.0+$(HarnessSourceCommit)</InformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HarnessVerify)' == 'true'">
    <DefineConstants>$(DefineConstants);HARNESS_VERIFY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CoreDir)\**\*.cs" Exclude="$(CoreDir)\obj\**;$(CoreDir)\bin\**" />
    <Compile Include="$(ClientDir)\**\*.cs" Exclude="$(ClientDir)\obj\**;$(ClientDir)\bin\**" />
    <Compile Include="$(PlatformApiDir)\**\*.cs" Exclude="$(PlatformApiDir)\obj\**;$(PlatformApiDir)\bin\**" Condition="'$(PlatformApiDir)' != ''" />
    <Compile Include="$(WpfDir)\**\*.cs" Exclude="$(WpfDir)\obj\**;$(WpfDir)\bin\**" Condition="'$(WpfDir)' != ''" />
    <Compile Include="$(Tree)\MantlePlace.Revit.Addin\**\*.cs" Exclude="$(Tree)\**\obj\**;$(Tree)\**\bin\**" />
    <Compile Include="TimingHarness.cs" />
    <Compile Include="Verify.cs" Condition="'$(HarnessVerify)' == 'true'" />
    <Compile Include="BuildInfo.g.cs" Condition="Exists('BuildInfo.g.cs')" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <EmbeddedResource Include="$(Tree)\MantlePlace.Revit.Addin\Families\*.rfa" LogicalName="MantlePlace.Revit.Addin.Families.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(Tree)\MantlePlace.Revit.Addin\Resources\MantlePlaceMark_*.png" LogicalName="MantlePlace.Wpf.Resources.%(Filename)%(Extension)" Condition="'$(WpfDir)' != ''" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HarnessTag</_Parameter1>
      <_Parameter2>$(HarnessTag)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SourceCommit</_Parameter1>
      <_Parameter2>$(HarnessSourceCommit)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SourceRoot</_Parameter1>
      <_Parameter2>$(Tree)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
