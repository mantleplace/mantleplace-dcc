#!/bin/sh
# The last look before anything becomes public. A push publishes the branch name and every commit
# message in it immediately — CI runs after, and can only block the merge, never the publication.
# This hook checks both for private references while they are still local.
#
# Opt in once per clone:  git config core.hooksPath .githooks
# Escape hatch:           git push --no-verify   (the CI gate still runs, after the fact)
#
# stdin: one "<local_ref> <local_sha> <remote_ref> <remote_sha>" line per ref being pushed.

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "pre-push: python not found; the public-reference gate cannot run." >&2
    echo "Install Python or push with --no-verify (CI will still check)." >&2
    exit 1
fi

GATE="$(git rev-parse --show-toplevel)/tools/public-hygiene/check_public_references.py"
ZERO=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # A deletion publishes nothing new.
    [ "$local_sha" = "$ZERO" ] && continue

    branch=${remote_ref#refs/heads/}
    if [ "$branch" != "$remote_ref" ]; then
        "$PYTHON" "$GATE" --branch-name "$branch" || status=1
    fi

    # Only the commits this push would publish. origin/main is always excluded: history that
    # predates the gate is accepted as record and must not be re-litigated on every push.
    if [ "$remote_sha" = "$ZERO" ]; then
        "$PYTHON" "$GATE" --commit-range "$local_sha" --not origin/main || status=1
    else
        "$PYTHON" "$GATE" --commit-range "$local_sha" --not "$remote_sha" origin/main || status=1
    fi
done

exit $status
