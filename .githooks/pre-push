#!/bin/sh
# The last look before anything becomes public. A push publishes the branch name and every commit
# message in it immediately — CI runs after, and can only block the merge, never the publication.
# This hook checks both for private references while they are still local.
#
# Opt in once per clone:  git config core.hooksPath .githooks
# Escape hatch:           git push --no-verify   (the CI gate still runs, after the fact)
#
# stdin: one "<local_ref> <local_sha> <remote_ref> <remote_sha>" line per ref being pushed.

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "pre-push: python not found; the public-reference gate cannot run." >&2
    echo "Install Python or push with --no-verify (CI will still check)." >&2
    exit 1
fi

GATE="$(git rev-parse --show-toplevel)/tools/public-hygiene/check_public_references.py"
ZERO=0000000000000000000000000000000000000000
status=0

# origin/main excludes history that predates the gate — accepted as record, never re-litigated.
# It is probed, not assumed: a --single-branch clone or a differently-named remote has no such
# ref, and hardcoding it would refuse every push from that clone with a git error.
MAIN_EXCLUDE=""
git rev-parse -q --verify origin/main >/dev/null 2>&1 && MAIN_EXCLUDE="origin/main"

while read -r local_ref local_sha remote_ref remote_sha; do
    # A deletion publishes nothing new.
    [ "$local_sha" = "$ZERO" ] && continue

    branch=${remote_ref#refs/heads/}
    if [ "$branch" != "$remote_ref" ]; then
        "$PYTHON" "$GATE" --branch-name "$branch" || status=1
    fi

    # Only the commits this push would publish. The remote's old tip need not exist locally
    # (a second remote never fetched, a force-push after the remote advanced) — probe it too.
    # A trailing --not with nothing after it is a git no-op, so empty exclusions are safe.
    OLD_TIP=""
    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
        OLD_TIP=$remote_sha
    fi
    "$PYTHON" "$GATE" --commit-range "$local_sha" --not $OLD_TIP $MAIN_EXCLUDE || status=1
done

exit $status
