            "mesh_import": {
              "ready": false,
              "reason": "available_on_request"
            }
          }
        }
      },
      "materialized": true,
      "note": "the host key inside dcc_readiness is deliberately one no shipped host recognises — the OBJECT's presence is the signal, which is what absorbs host-roster staleness."
    },
