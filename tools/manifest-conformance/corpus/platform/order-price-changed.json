      "quote": {
        "extent": {
          "west": -122.42,
          "south": 37.7,
          "east": -122.4,
          "north": 37.72
        },
        "areaKm2": 3.91,
        "priceCents": 1300,
        "currency": "usd",
        "pricingConfigVersion": 7,
        "freeEligible": false,
        "coverage": "covered",
        "licence": {
          "line": "Synthetic licence line for the conformance corpus.",
          "url": "https://example.com/licence-terms"
        }
      }
    }
  }
}
