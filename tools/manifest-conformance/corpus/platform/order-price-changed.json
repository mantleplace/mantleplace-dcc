{
  "operationId": "placeOrder",
  "request": {
    "method": "POST",
    "path": "/api/v1/orders",
    "headers": {
      "Mantle-Place-Client": "revit/1.0.0",
      "Authorization": "Bearer corpus-access-token",
      "Idempotency-Key": "corpus-0123456789abcdef"
    },
    "body": {
      "extent": {
        "west": -122.42,
        "south": 37.7,
        "east": -122.4,
        "north": 37.72
      },
      "expectedPriceCents": 1234,
      "payment": "credit"
    }
  },
  "response": {
    "status": 409,
    "body": {
