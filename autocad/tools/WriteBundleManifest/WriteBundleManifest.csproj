<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The package script's way to ask the core for the bundle manifest. The script is PowerShell and
    the manifest is built by a pure function (AutodeskBundleManifest, compiled in from the Revit
    plugin's Core), which Windows PowerShell 5.1 cannot load; a one-file console project is the
    smallest honest bridge.

    Not shipped, and not run in CI: the package script is the only caller (it cannot run in CI
    either, tools/Package-MantlePlaceAutoCad.ps1). The function it calls IS covered, in
    MantlePlace.AutoCad.Core.Tests. NO NUGET PACKAGES, same as the rest of the tree.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MantlePlace.AutoCad.Tools.WriteBundleManifest</RootNamespace>
    <AssemblyName>MantlePlace.AutoCad.WriteBundleManifest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MantlePlace.AutoCad.Core\MantlePlace.AutoCad.Core.csproj" />
  </ItemGroup>

</Project>
