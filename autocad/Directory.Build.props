<Project>

  <PropertyGroup>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AutoCadApiDirNet8 Condition="'$(AutoCadApiDirNet8)' == ''">$(ProgramFiles)\Autodesk\AutoCAD 2025</AutoCadApiDirNet8>
    <AutoCadApiDirNet10 Condition="'$(AutoCadApiDirNet10)' == ''">$(ProgramFiles)\Autodesk\AutoCAD 2027</AutoCadApiDirNet10>
  </PropertyGroup>

  <Target Name="MarkDirtySourceRevision"
          AfterTargets="InitializeSourceControlInformation"
          BeforeTargets="GetAssemblyVersion"
          Condition="'$(SourceRevisionId)' != '' and !$(SourceRevisionId.EndsWith('-dirty'))">
    <Exec Command="git status --porcelain --untracked-files=all -- &quot;$(MSBuildThisFileDirectory).&quot; &quot;$(MSBuildThisFileDirectory)..\shared&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MantlePlaceAutoCadStatus" />
      <Output TaskParameter="ExitCode" PropertyName="_MantlePlaceAutoCadStatusExit" />
    </Exec>
    <PropertyGroup Condition="'$(_MantlePlaceAutoCadStatusExit)' == '0' and '$(_MantlePlaceAutoCadStatus)' != ''">
      <SourceRevisionId>$(SourceRevisionId)-dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
