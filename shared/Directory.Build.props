<Project>

  <!--
    Shared MSBuild properties for the host-neutral .NET code: the pure core, the client and the
    generated Platform API client every .NET host plugin builds from, and their headless suite.

    Three rules worth knowing before adding a project here:

      1. NO NUGET PACKAGES. The pure core and its conformance suite restore offline and have zero
         third-party references, the same reason the conformance gate uses stdlib unittest ("no
         dependency install to rot", .github/workflows/ci-manifest-conformance.yml). The host plugin
         doctrine is dumb, dependency-light consumers (HPS-03).

      2. NO HOST API, and no host's name in a project, a namespace or a folder. A project that needs
         a host's assemblies belongs in that host's tree; a decision that differs by host reads
         HostIdentity, which the host's shell sets once at startup.

      3. NO VERSION. These assemblies ship inside each host's plugin, and the plugin's version has one
         home per host (revit/Directory.Build.props, autocad/Directory.Build.props). What the
         platform is told about the plugin's version is what the host hands HostIdentity, read from
         the host's own assembly, so nothing reads the version these assemblies carry.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

</Project>
